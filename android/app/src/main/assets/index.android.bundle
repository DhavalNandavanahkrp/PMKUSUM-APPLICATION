      var ra = 24 * 60 / Math.PI * 0.082 * drValue * (wsValue * Math.sin(latitudeCal) * Math.sin(dabaValue) + Math.cos(latitudeCal) * Math.cos(dabaValue) * Math.sin(wsValue));
      return ra; //.toFixed(2);
