      return monthValue < 3 ? parseInt(275 * (monthValue / 9) - 30 + dayValue) - 2 + 2 : parseInt(275 * (monthValue / 9) - 30 + dayValue) - 2;

      //B is All date to 1/1/2009 to 31/12/2018
    };
    var CalculateWs = function CalculateWs(dabaValue, latitudeCal) {
